<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings (product_pricelist_auto_mailing)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pwa_settings']" position="before">
                <block title="Pricelist notifications" id="pricelist_changes_settings">
                    <setting help="Users who will receive notice of pricelist changed by users so marked.">
                        <field name="user_notified_for_price_changes_ids" widget="many2many_tags"/>
                    </setting>
                    <setting help="Users to take into account when changing the content of a pricelist.">
                        <field name="user_notifying_price_changes_ids" widget="many2many_tags"/>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>
