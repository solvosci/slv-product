<odoo>
    <data noupdate="1">
        <record id="mail_template_data_pricelist_notification" model="mail.template">
            <field name="name">Pricelist Notification</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="model_id" ref="model_product_pricelist"/>
            <field name="subject">Pricelist modified</field>
            <field name="body_html" type="html">
                <div>
                    <p style="font-size: 13px;">
                        <t t-foreach="ctx.get('body', [])" t-as="line">
                            <t t-esc="line"/><br/>
                        </t>
                        <br/>
                        Please review.<br/>
                        Thanks.
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
