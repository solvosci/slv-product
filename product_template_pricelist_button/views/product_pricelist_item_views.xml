<odoo>
    <record id="product_pricelist_item_tree_view_from_product" model="ir.ui.view">
        <field name="name">product.pricelist.item.tree (in product_pricelist_item_formula_visibility)</field>
        <field name="model">product.pricelist.item</field>
        <field
            name="inherit_id"
            ref="product.product_pricelist_item_tree_view_from_product"
        />
        <field name="arch" type="xml">
            <field name="fixed_price" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="string">Fixed Price</attribute>
            </field>
            <field name="min_quantity" position="before">
                <field name="price"/>
            </field>
            <field name="min_quantity" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>
</odoo>
