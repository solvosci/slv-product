<odoo>
    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.product.tree (in product_dynamic_list_price)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="list_price" position="after">
                <field
                    name="list_price_2"
                    string="RRP"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                    optional="show"
                    decoration-muted="not sale_ok"
                    readonly="1"
                />
            </field>
        </field>
    </record>

    <record id="product_template_kanban_view" model="ir.ui.view">
        <field name="name">Product.template.product.kanban (in product_dynamic_list_price)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <div name="product_lst_price" position="attributes">
                <attribute name="t-if">False</attribute>
            </div>
            <div name="product_lst_price" position="after">
                <div name="product_lst_price_2" class="mt-1">
                    RRP: <field
                        name="list_price_2"
                        widget="monetary"
                        options="{'currency_field': 'currency_id', 'field_digits': True}"
                    />
                </div>            
            </div>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form (in product_dynamic_list_price)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="before">
                <field
                    name="list_price_2"
                    widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"
                    readonly="1"
                    string="RRP"
                />
            </field>
        </field>
    </record>
</odoo>
