<odoo>
    <record
        id="action_product_supplierinfo_recalculate_list_price_2"
        model="ir.actions.server"
    >
        <field name="name">Recalculate RRP</field>
        <field name="model_id" ref="product.model_product_supplierinfo"/>
        <field name="binding_model_id" ref="product.model_product_supplierinfo"/>
        <field name="binding_view_types">tree,form</field>
        <field name="state">code</field>
        <field
            name="groups_id"
            eval="[Command.link(ref('product.group_product_pricelist'))]"
        />
        <field name="code">
        if records:
            product_tmpl_ids = (
                record.product_tmpl_id
                | record.product_id.product_tmpl_id
            )
            product_tmpl_ids.action_recalculate_list_price_2()</field>
    </record>
</odoo>
