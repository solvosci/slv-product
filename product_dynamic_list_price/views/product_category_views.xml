<odoo>
    <record
        id="action_product_category_recalculate_list_price_2"
        model="ir.actions.server"
    >
        <field name="name">Recalculate RRP</field>
        <field name="model_id" ref="stock.model_product_category"/>
        <field name="binding_model_id" ref="stock.model_product_category"/>
        <field name="binding_view_types">tree,form</field>
        <field name="state">code</field>
        <field
            name="groups_id"
            eval="[Command.link(ref('product.group_product_pricelist'))]"
        />
        <field name="code">
        if records:
            records.action_recalculate_list_price_2()</field>
    </record>
</odoo>
