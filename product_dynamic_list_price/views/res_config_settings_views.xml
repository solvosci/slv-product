<odoo>
    <record id="res_config_settings_view_form_product_pricing" model="ir.ui.view">
        <field name="name">res.config.settings (in product_dynamic_list_price)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="before">
                <block title="Product" groups="product.group_product_pricelist">
                    <setting string="Reference Pricelist for Dynamic Sale Price">
                        <field name="reference_pricelist_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
