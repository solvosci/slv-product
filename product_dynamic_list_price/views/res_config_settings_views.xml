<odoo>
    <record id="res_config_settings_view_form_product_pricing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale (in product_dynamic_list_price)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting
                    string="Reference Pricelist for Dynamic Sale Price"                        
                    groups="product.group_product_pricelist"
                >
                    <field name="reference_pricelist_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
